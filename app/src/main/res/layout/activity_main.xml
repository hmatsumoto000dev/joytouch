<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Guideline to split the screen for movement and action -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <!-- Navigation Menu at Top (Landscape) -->
    <com.example.joytouch.CustomBottomNavigationView
        android:id="@+id/top_navigation"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#F01E1E1E"
        android:elevation="8dp"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:labelVisibilityMode="labeled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/top_nav_menu" />

    <!-- Navigation Rail at Side (Portrait) -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/side_navigation"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:background="#F01E1E1E"
        android:elevation="8dp"
        android:visibility="gone"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:labelVisibilityMode="labeled"
        app:menuGravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/top_nav_menu" />

    <!-- Landscape Nav Tab (Top Center) -->
    <FrameLayout
        android:id="@+id/nav_toggle_tab_land"
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_nav_tab_land"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/nav_toggle_icon_land"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Toggle Menu"
            android:src="@drawable/ic_arrow_down"
            app:tint="#B3FFFFFF" />
    </FrameLayout>

    <!-- Portrait Nav Tab (Left Center) -->
    <FrameLayout
        android:id="@+id/nav_toggle_tab_port"
        android:layout_width="24dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_nav_tab_port"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25">

        <ImageView
            android:id="@+id/nav_toggle_icon_port"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Toggle Menu"
            android:src="@drawable/ic_arrow_right"
            app:tint="#B3FFFFFF" />
    </FrameLayout>

    <!-- About Button (Hidden, triggered via menu) -->
    <View
        android:id="@+id/btn_about"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Connect Button (Hidden, triggered via menu) -->
    <View
        android:id="@+id/btn_connect"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/touchpad_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#22FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_left_click"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Left Click" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_right_click"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Right Click" />
        </LinearLayout>
    </FrameLayout>

    <!-- Dummy views for backward compatibility with logic -->
    <View
        android:id="@+id/btn_mode_toggle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/btn_touchpad_toggle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Movement Buttons (Left Side) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_down"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="80dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_down"
        android:textSize="24sp"
        app:cornerRadius="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_center"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_left"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="12dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_left"
        android:textSize="24sp"
        app:cornerRadius="35dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_down"
        app:layout_constraintEnd_toStartOf="@+id/btn_down"
        app:layout_constraintTop_toTopOf="@+id/btn_down" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_right"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="12dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_right"
        android:textSize="24sp"
        app:cornerRadius="35dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_down"
        app:layout_constraintStart_toEndOf="@+id/btn_down"
        app:layout_constraintTop_toTopOf="@+id/btn_down" />

    <!-- Up/Jump Button (Larger, positioned above others) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_up"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="16dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_up"
        android:textSize="32sp"
        app:backgroundTint="#E91E63"
        app:cornerRadius="50dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_down"
        app:layout_constraintEnd_toEndOf="@+id/btn_right"
        app:layout_constraintStart_toStartOf="@+id/btn_left" />

    <!-- Action Buttons (Right Side) -->
    <!-- Grid 4x2 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk1"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk1"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_atk5"
        app:layout_constraintEnd_toStartOf="@+id/btn_atk2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/guideline_center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk2"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginStart="12dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk2"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_atk1"
        app:layout_constraintEnd_toStartOf="@+id/btn_atk3"
        app:layout_constraintStart_toEndOf="@+id/btn_atk1"
        app:layout_constraintTop_toTopOf="@+id/btn_atk1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk3"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginStart="12dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk3"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_atk2"
        app:layout_constraintEnd_toStartOf="@+id/btn_atk4"
        app:layout_constraintStart_toEndOf="@+id/btn_atk2"
        app:layout_constraintTop_toTopOf="@+id/btn_atk2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk4"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginStart="12dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk4"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_atk3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_atk3"
        app:layout_constraintTop_toTopOf="@+id/btn_atk3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk5"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="12dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk5"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btn_atk1"
        app:layout_constraintStart_toStartOf="@+id/btn_atk1"
        app:layout_constraintTop_toBottomOf="@+id/btn_atk1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk6"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginStart="12dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk6"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_atk5"
        app:layout_constraintEnd_toEndOf="@+id/btn_atk2"
        app:layout_constraintStart_toStartOf="@+id/btn_atk2"
        app:layout_constraintTop_toTopOf="@+id/btn_atk5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk7"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk7"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_atk6"
        app:layout_constraintEnd_toEndOf="@+id/btn_atk3"
        app:layout_constraintStart_toStartOf="@+id/btn_atk3"
        app:layout_constraintTop_toTopOf="@+id/btn_atk6" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_atk8"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_atk8"
        app:cornerRadius="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_atk7"
        app:layout_constraintEnd_toEndOf="@+id/btn_atk4"
        app:layout_constraintStart_toStartOf="@+id/btn_atk4"
        app:layout_constraintTop_toTopOf="@+id/btn_atk7" />

    <!-- Button resize size badge (Pattern A) -->
    <TextView
        android:id="@+id/tv_size_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_size_badge"
        android:elevation="20dp"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="140 × 140 px (70 dp)" />

</androidx.constraintlayout.widget.ConstraintLayout>
